# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose sets this to postgres:5432 via environment: override.
# For local dev outside Docker: localhost:5433 (compose maps host 5433 → container 5432).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/investment

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Port mapping: host 8001 → container 8000.
# Local dev (outside Docker): localhost:8001
# Inside Docker (api/worker/beat): chroma:8000  — set via docker-compose environment: block, not here.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Anthropic / LLM ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM_ENABLED=false  — default off; set true to enable LLM analysis
LLM_ENABLED=false
# LLM_PROVIDER routes research-graph LLM analysis:
#   anthropic (default) — Claude API, needs ANTHROPIC_API_KEY
#   ollama              — fully local via Ollama (see OLLAMA_RESEARCH_MODEL below)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ── IBKR (read-only, TWS / IB Gateway must be running on host) ───────────────
# Default off — set true when TWS/IB Gateway is running and configured
IBKR_ENABLED=false

# host.docker.internal resolves to host machine on Mac/Windows Docker Desktop
# Use localhost when running the API directly outside Docker
IBKR_HOST=host.docker.internal

# Port guide:
#   7497 = TWS paper trading (default for dev)
#   7496 = TWS live trading
#   4002 = IB Gateway paper trading
#   4001 = IB Gateway live trading
IBKR_PORT=7497

IBKR_CLIENT_ID=1
IBKR_TIMEOUT_SECONDS=30
IBKR_TRADE_HISTORY_MONTHS=12

# Always true — system is read-only, never submits orders
IBKR_READONLY=true

# TWS setup required:
#   Configure → API → Settings
#   ☑ Enable ActiveX and Socket Clients
#   ☑ Read-Only API (recommended)
#   Trusted IPs: 127.0.0.1 and Docker bridge IP (e.g. 172.17.0.1)

# ── IBKR Flex Query (historical trade import) ─────────────────────────────────
# Flex Query pulls full trade history from IBKR servers — not limited to current session.
# reqExecutions (above) only returns current TWS session. Flex is the historical source.
#
# Setup:
#   1. Log in to IBKR Account Management
#   2. Reports → Flex Queries → Create New Query
#   3. Select "Trades" section. Required fields:
#      TradeDate, Symbol, Buy/Sell, Quantity, TradePrice, IBCommission, Currency,
#      TransactionID, OrderID, Exchange
#   4. Set delivery: XML format, Date range: Last N Days
#   5. Copy the Token (top of Flex Queries page) and Query ID
#
# Security: never commit token or query ID to git.
# They are secrets — treat like API keys.
IBKR_FLEX_ENABLED=false
IBKR_FLEX_TOKEN=your-flex-token-here
IBKR_FLEX_QUERY_ID=your-query-id-here
# Leave these at defaults unless IBKR changes the endpoint:
# IBKR_FLEX_TIMEOUT_SECONDS=60
# IBKR_FLEX_MAX_POLLS=10
# IBKR_FLEX_POLL_INTERVAL_SECONDS=3

# ── News ─────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=your-newsapi-key-here

# ── Social sentiment (StockTwits + X) ─────────────────────────────────────────
# Default off. When enabled, research runs fetch StockTwits messages, merge
# them with DB-stored X posts, and blend the social score into the news
# component (weights in strategy config "sentiment_blend", default 0.7/0.3).
# Replay caveat: StockTwits keeps only ~30 recent messages — replay runs for
# dates before ingestion get the neutral 5.0 stub and no blend, so replay
# scores stay comparable.
SOCIAL_ENABLED=false
SOCIAL_PROVIDER=stocktwits
# SOCIAL_LOOKBACK_DAYS=7
# SOCIAL_MAX_POSTS_PER_SYMBOL=30
# SOCIAL_TIMEOUT_SECONDS=10

# ── X scraping (host-only CLI, never in Docker / research graph) ─────────────
# Requires: pip install -e ".[social]" && playwright install chromium
# One-time login (saves session): python -m apps.cli.scrape_x --login
# Scrape:                          make scrape-x SYMBOLS=AAPL,NVDA
# Use a throwaway X account — scraping violates X ToS and risks account flags.
X_SCRAPE_ENABLED=false
X_SCRAPE_ACCOUNTS=
X_SESSION_STATE_PATH=
# X_SCRAPE_MIN_DELAY_SECONDS=5

# ── Ollama (local LLM — never sends data to cloud) ────────────────────────────
# Ollama must be running on the host. Default off.
# OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b            ← backtest analyst model
# OLLAMA_TIMEOUT_SECONDS=60
# Research-graph model used when LLM_PROVIDER=ollama (ollama pull qwen3:32b first):
# OLLAMA_RESEARCH_MODEL=qwen3:32b
# OLLAMA_RESEARCH_TIMEOUT_SECONDS=120

# ── Scheduled research (Celery beat — twice-daily automatic runs) ─────────────
# Default off to prevent surprise runs. Set SCHEDULED_RESEARCH_ENABLED=true to
# activate. Requires the beat service to be running (docker compose up beat).
#
# SCHEDULED_RESEARCH_USER_ID — UUID of the user that owns scheduled runs.
#   Default is the dev default user. Override per-deployment.
# SCHEDULED_RESEARCH_HOURS — comma-separated UTC hours, e.g. "9,16" → 09:30 and 16:30 UTC.
# SCHEDULED_RESEARCH_MINUTE — minute within each hour (default 30).
#
SCHEDULED_RESEARCH_ENABLED=false
SCHEDULED_RESEARCH_USER_ID=00000000-0000-0000-0000-000000000001
SCHEDULED_RESEARCH_HOURS=9,16
SCHEDULED_RESEARCH_MINUTE=30

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
