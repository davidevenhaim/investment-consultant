# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/investment

# Redis
REDIS_URL=redis://redis:6379/0

# ChromaDB — host port 8001 maps to container port 8000
CHROMA_HOST=chroma
CHROMA_PORT=8001

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# IBKR (TWS must be running separately on host machine)
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# News
NEWSAPI_KEY=...

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
